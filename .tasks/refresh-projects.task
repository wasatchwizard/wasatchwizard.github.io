description: Create project pages and refresh their GitHub metadata.
options:
  - name: api-url
    default: https://api.github.com/users/kodybrown/repos
    description: Public repository API endpoint for the website owner.
  - name: output
    type: path
    default: src/projects
    description: Project content directory relative to the website root.

steps:
  - id: repositories
    http:
      method: GET
      url: {parameter: api-url}
      query:
        type: owner
        per_page: 100
      headers:
        Accept: application/vnd.github+json
      response-format: json
      pagination:
        mode: link-header
        relation: next
      timeout-seconds: 30

  - id: originals
    json:
      operation: filter
      input: {result: repositories.data}
      where:
        field: fork
        equals: false

  - foreach:
      items: {result: originals.data}
      as: repo
    steps:
      - id: documentPath
        text:
          template: "{{directory}}/{{name}}.md"
          values:
            directory: {parameter: output}
            name: {item: repo.name}

      - id: disabledPath
        text:
          template: "{{path}}.disabled"
          values:
            path: {result: documentPath.text}

      - id: disabledDocument
        file:
          operation: read
          path: {result: disabledPath.text}
          optional: true

      # A disabled file keeps receiving metadata updates. Select its filename
      # before writing so a refresh never recreates the publishing .md file.
      - id: selectedDocument
        json:
          operation: filter
          input:
            - path: {result: documentPath.text}
              disabled: false
            - path: {result: disabledPath.text}
              disabled: true
          where:
            field: disabled
            equals: {result: disabledDocument.exists}

      - foreach:
          items: {result: selectedDocument.data}
          as: document
        steps:
          - id: projectDocument
            file:
              operation: frontmatter
              path: {item: document.path}
              create-if-missing: true
              initial:
                title: {item: repo.name}
                summary: ""
                screenshot: ""
                hidden: false
              # A name reused by another repository must not overwrite this page.
              match-existing:
                github.id: {item: repo.id}
              set:
                github.id: {item: repo.id}
                github.repository: {item: repo.full_name}
                github.url: {item: repo.html_url}
                github.description: {item: repo.description}
                github.pushedAt: {item: repo.pushed_at}
                github.language: {item: repo.language}
                github.archived: {item: repo.archived}

          # A one-item scope avoids every README request for nonempty bodies.
          # Check again inside the guarded file update before seeding any content.
          - when: {result: projectDocument.body-empty}
            foreach:
              items: [{item: document.path}]
              as: emptyDocument
            steps:
              - id: readmeEndpoint
                text:
                  template: "{{repository}}/readme"
                  values:
                    repository: {item: repo.url}

              - id: readmeMetadata
                http:
                  method: GET
                  url: {result: readmeEndpoint.text}
                  headers:
                    Accept: application/vnd.github+json
                  response-format: json
                  optional: true
                  timeout-seconds: 30

              - id: readmeContent
                when: {result: readmeMetadata.found}
                http:
                  method: GET
                  url: {result: readmeMetadata.data.download_url}
                  response-format: text
                  # A few old READMEs use ANSI table characters. Prefer UTF-8;
                  # permit this explicit legacy encoding only when UTF-8 fails.
                  fallback-encoding: windows-1252
                  timeout-seconds: 30

              - when: {result: readmeMetadata.found}
                file:
                  operation: frontmatter
                  path: {item: emptyDocument}
                  expected-sha256: {result: projectDocument.sha256}
                  match-existing:
                    github.id: {item: repo.id}
                  set:
                    github.readmeUrl: {result: readmeMetadata.data.html_url}
                    github.readmeDownloadUrl: {result: readmeMetadata.data.download_url}
                  body-if-empty:
                    content: {result: readmeContent.data}
                    strip-first-h1: true
