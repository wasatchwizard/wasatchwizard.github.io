<ol class="post-list">
  {% for post in posts %}
  <li>
    {% if section == 'home' %}<h3>{% else %}<h2>{% endif %}<a href="{{ post.url }}">{{ post.data.title }}</a>{% if section == 'home' %}</h3>{% else %}</h2>{% endif %}
    <p class="post-meta"><time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time></p>
    <p>{{ post.data.summary }}</p>
  </li>
  {% endfor %}
</ol>
