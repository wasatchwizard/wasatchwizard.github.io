---
layout: base.njk
detailIndexUrl: /blog/
detailIndexLabel: All posts
---
{% extends "detail.njk" %}
{% block detailMeta %}
<p class="post-meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>{% if topics.length %} · {{ topics | join(' · ') }}{% endif %}</p>
{% endblock %}
{% block detailContent %}
{% if migrationNote %}<p class="migration-note">{{ migrationNote }}</p>{% endif %}
{{ content | safe }}
{# Posts are newest first: the next collection item is the older article. #}
{% set older = collections.posts | getNextCollectionItem(page) %}
{% set newer = collections.posts | getPreviousCollectionItem(page) %}
{% if older or newer %}
<nav class="post-navigation" aria-label="Adjacent blog posts">
  {% if older %}
  <a class="post-navigation-older" href="{{ older.url }}">
    <span class="post-navigation-label">← Older</span>
    <span class="post-navigation-title">{{ older.data.title }}</span>
  </a>
  {% endif %}
  {% if newer %}
  <a class="post-navigation-newer" href="{{ newer.url }}">
    <span class="post-navigation-label">Newer →</span>
    <span class="post-navigation-title">{{ newer.data.title }}</span>
  </a>
  {% endif %}
</nav>
{% endif %}
{% endblock %}
