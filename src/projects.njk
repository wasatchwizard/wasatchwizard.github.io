---
layout: base.njk
title: Projects
section: projects
permalink: /projects/
---
<div class="prose">
  <h1>Projects</h1>
  <p class="intro">Software, small tools, and experiments from my workbench.</p>
  <p>These are a few of my public projects, listed by their latest code push. My usable freeware and open-source releases also have a home at <a href="https://weekendtech.net/">WeekendTech</a>.</p>
  {% if collections.projects.length %}
  <ul class="project-list">
    {% for project in collections.projects %}
    <li>
      <h2 class="project-heading">
        <a href="{{ project.url }}">{{ project.data.title }}</a>
        <a class="project-source-link" href="{{ project.data.github.url }}" aria-label="View {{ project.data.title }} source on GitHub (external site)" title="View source on GitHub (external site)">
          {# Reuse the local MIT-licensed Bootstrap GitHub silhouette; the arrow marks an external destination. #}
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
            <path transform="translate(1 4) scale(1.125)" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/>
            {# A wider white stroke separates the overlaid arrow from the Octocat beneath it. #}
            <path d="M15 3h6v6m0-6-8 8" fill="none" stroke="#fff" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M15 3h6v6m0-6-8 8" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </h2>
      <p>{{ project.data.projectSummary }}</p>
      {% if project.data.github.language or project.data.github.pushedAt or project.data.github.archived %}
      <p class="post-meta">{% if project.data.github.language %}{{ project.data.github.language }}{% endif %}{% if project.data.github.pushedAt %}{% if project.data.github.language %} · {% endif %}Updated <time datetime="{{ project.data.github.pushedAt }}">{{ project.data.github.pushedAt | readableDate }}</time>{% endif %}{% if project.data.github.archived %}{% if project.data.github.language or project.data.github.pushedAt %} · {% endif %}Archived{% endif %}</p>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p>Project notes are on the way. You can also <a href="https://github.com/kodybrown?tab=repositories">browse my repositories on GitHub</a>.</p>
  {% endif %}
</div>
