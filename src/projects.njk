---
layout: base.njk
title: Projects
section: projects
permalink: /projects/
---
{% from "project-meta.njk" import projectMeta %}
<div class="prose"{% if collections.projects.length %} data-project-catalog{% endif %}>
  <h1>Projects</h1>
  <p class="intro">Software, small tools, and experiments from my workbench.</p>
  <p>These are a few of my public projects, listed by their latest code push. My usable freeware and open-source releases also have a home at <a href="https://weekendtech.net/">WeekendTech</a>.</p>
  {% if collections.projects.length %}
  <form class="site-search" role="search" aria-label="Search projects" hidden>
    <label for="project-query">Search projects</label>
    <div class="site-search-controls">
      <input id="project-query" name="q" type="search" placeholder="Titles and descriptions" aria-controls="project-results" autocomplete="off">
      <button type="reset">Clear</button>
    </div>
  </form>
  <p id="project-search-status" class="post-meta" role="status" aria-live="polite" hidden></p>
  <ul id="project-results" class="project-list">
    {% for project in collections.projects %}
    <li>
      <h2><a href="{{ project.url }}">{{ project.data.title }}</a></h2>
      <p class="project-summary">{{ project.data.projectSummary }}</p>
      {{ projectMeta(project.data.github) }}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p>Project notes are on the way. You can also <a href="https://github.com/kodybrown?tab=repositories">browse my repositories on GitHub</a>.</p>
  {% endif %}
</div>
{% if collections.projects.length %}
<script type="module" src="{{ "/assets/site-search.js" | assetVersion }}"></script>
{% endif %}
